# ==============================================================================
# CrisisMap AP - Backend Environment Configuration Template
# Copy this file to '.env' in the same directory and fill in your actual credentials.
# ==============================================================================

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
ENVIRONMENT=development

# Database Configuration (MySQL)
# Update DB_USER and DB_PASSWORD with your MySQL credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=crisismap_db

# CORS Allowed Origins (Comma-separated URLs for the React frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
